@page "/apis/client-profile/knowledge-and-experiences/resolve"
@inject IClientProfileClient Client

<PageTitle>Resolve knowledge and experience - Bloxx API Test</PageTitle>

<ApiOperation Title="Resolve knowledge and experience"
              Method="GET"
              Path="/client-profiling/knowledge-and-experiences"
              Description="Finder det aktive spørgeskema for personen. Svaret er en omdirigering (303); 304 betyder uændret."
              CanSend="@(!string.IsNullOrWhiteSpace(_personId))"
              Execute="ExecuteAsync">
    <MudTextField @bind-Value="_personId" Label="personId (påkrævet)" Variant="Variant.Outlined" />
    <MudTextField @bind-Value="_acceptLanguage" Label="Accept-Language (valgfri)" Placeholder="da" Variant="Variant.Outlined" />
</ApiOperation>

@code {
    private string? _personId;
    private string? _acceptLanguage;

    private async Task<ApiCallResult> ExecuteAsync(CancellationToken cancellationToken) =>
        ApiCallResult.FromLocation(await Client.ResolveKnowledgeAndExperienceAsync(
            _personId!.Trim(),
            InputParser.NullIfEmpty(_acceptLanguage),
            cancellationToken));
}
