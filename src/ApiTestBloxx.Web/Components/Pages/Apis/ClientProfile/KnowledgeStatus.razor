@page "/apis/client-profile/knowledge-and-experiences/status"
@inject IClientProfileClient Client

<PageTitle>Change status of knowledge and experience - Bloxx API Test</PageTitle>

<ApiOperation Title="Change status of knowledge and experience"
              Method="PUT"
              Path="/client-profiling/knowledge-and-experiences/{id}/status"
              Description="Aktiverer eller arkiverer et spørgeskema. Kræver Last-Modified fra seneste svar (If-Unmodified-Since)."
              CanSend="@(!string.IsNullOrWhiteSpace(_id) && !string.IsNullOrWhiteSpace(_ifUnmodifiedSince))"
              Execute="ExecuteAsync">
    <MudTextField @bind-Value="_id" Label="id (påkrævet)" Variant="Variant.Outlined" />
    <MudSelect T="QuestionnaireStatus" @bind-Value="_status" Label="status" Variant="Variant.Outlined">
        <MudSelectItem T="QuestionnaireStatus" Value="@QuestionnaireStatus.Active">ACTIVE</MudSelectItem>
        <MudSelectItem T="QuestionnaireStatus" Value="@QuestionnaireStatus.Archived">ARCHIVED</MudSelectItem>
    </MudSelect>
    <MudTextField @bind-Value="_ifUnmodifiedSince" Label="If-Unmodified-Since (påkrævet)" HelperText="Last-Modified fra Get/Create, fx Fri, 27 Sep 2019 11:00:00 GMT" Variant="Variant.Outlined" />
    <MudTextField @bind-Value="_acceptLanguage" Label="Accept-Language (valgfri)" Placeholder="da" Variant="Variant.Outlined" />
</ApiOperation>

@code {
    private string? _id;
    private QuestionnaireStatus _status = QuestionnaireStatus.Active;
    private string? _ifUnmodifiedSince;
    private string? _acceptLanguage;

    private async Task<ApiCallResult> ExecuteAsync(CancellationToken cancellationToken) =>
        ApiCallResult.From(await Client.ChangeStatusOfKnowledgeAndExperienceAsync(
            _id!.Trim(),
            new StatusQuestionnaire { Status = _status },
            _ifUnmodifiedSince!.Trim(),
            InputParser.NullIfEmpty(_acceptLanguage),
            cancellationToken));
}
